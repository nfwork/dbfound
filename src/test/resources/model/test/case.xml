<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://dbfound.googlecode.com/model" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://dbfound.googlecode.com/model https://raw.githubusercontent.com/nfwork/dbfound/master/tags/model.xsd">

	<execute name="whenAndOtherwise">
		<sqls>
			<whenSql when="${@flag} = 0">
				<setContextData targetPath="outParam.result0" value="0"/>
			</whenSql>
			<otherwiseSql>
				<setContextData targetPath="outParam.result1" value="1"/>
			</otherwiseSql>
		</sqls>
	</execute>

	<execute name="caseAndWhenAndOtherwise">
		<sqls>
			<caseSql>
				<whenSql when="${@flag} = 0">
					<setContextData targetPath="outParam.result0" value="0"/>
				</whenSql>
				<whenSql when="${@flag} = 1">
					<setContextData targetPath="outParam.result1" value="1"/>
				</whenSql>
				<whenSql when="${@flag} = 2">
					<setContextData targetPath="outParam.result2" value="2"/>
				</whenSql>
				<otherwiseSql>
					<setContextData targetPath="outParam.result3" value="3"/>
				</otherwiseSql>
			</caseSql>
		</sqls>
	</execute>

	<execute name="setContextDataFromSourcePath">
		<sqls>
			<setContextData targetPath="outParam.result" sourcePath="param.source"/>
		</sqls>
	</execute>

	<execute name="setContextDataFromParam">
		<param name="sourceParam" value="paramValue"/>
		<sqls>
			<setContextData targetPath="outParam.paramValue" param="sourceParam"/>
		</sqls>
	</execute>

	<execute name="setContextDataFromCurrentPath">
		<sqls>
			<setContextData targetPath="name" value="xiaoming"/>
			<setContextData targetPath="age" value="18"/>
			<setContextData targetPath="desc" value=""/>
			<setContextData targetPath="tags" sourcePath="request.tags"/>
			<setContextData targetPath="school" sourcePath="csh"/>
		</sqls>
	</execute>

</model>